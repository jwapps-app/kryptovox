# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=kryptovox
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=kryptovox

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://kryptovox:change-me-in-prod@postgres:5432/kryptovox
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-64-char-random-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90
ALLOWED_ORIGINS=http://localhost:5173

# --- Web Push (Phase 6) ---
# The VAPID keypair is auto-generated and persisted (prod: /data/vapid_private.pem).
# You only need to set the contact email used in push requests.
VAPID_EMAIL=mailto:admin@yourdomain.com

# ===========================================================================
# Production / NAS deploy only (docker-compose.prod.yml)
# ===========================================================================

# GHCR images built by GitHub Actions. Set to your GitHub owner (lowercase).
#   e.g. ghcr.io/jworthington/kryptovox
IMAGE_PREFIX=ghcr.io/CHANGEME/kryptovox
IMAGE_TAG=latest

# Public origin served via Cloudflare Tunnel (used for CORS).
ALLOWED_ORIGINS=https://chat.yourdomain.com

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# gunicorn worker count
BACKEND_WORKERS=4
